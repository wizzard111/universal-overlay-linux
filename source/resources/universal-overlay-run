#!/bin/sh
# FPS for OpenGL games that X Present cannot see (NVIDIA, native Wayland).
# In Steam, set the game's launch options to:   universal-overlay-run %command%
# Vulkan games (including Proton/DXVK) need no wrapper — the Vulkan layer sees
# them, and OpenGL games on Mesa under X11/XWayland are measured without it.
#
# Both builds of the hook are preloaded, 64- and 32-bit. The loader silently
# skips the one that does not fit the process ("wrong ELF class" is harmless).
DIR=$(dirname "$(readlink -f "$0")")
for lib in "$DIR/libuo_glhook.so" "$DIR/libuo_glhook32.so"; do
    [ -f "$lib" ] && LD_PRELOAD="$lib${LD_PRELOAD:+:$LD_PRELOAD}"
done
export LD_PRELOAD
exec "$@"
